<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Domain projects must stay warning-free: invariants live here. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Domain')) Or '$(MSBuildProjectName)' == 'Nodo.SharedKernel'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
